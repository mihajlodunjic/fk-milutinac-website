---
import { business } from "@/data/business";

type Props = {
  size?: "small" | "regular" | "large";
  withText?: boolean;
};

const { size = "regular", withText = false } = Astro.props;
---

<span class={`club-logo club-logo--${size}`} aria-label="FK Milutinac Zemun">
  <picture>
    <source srcset={business.logoWebp} type="image/webp" />
    <img
      src={business.logo}
      width="1242"
      height="1242"
      alt="Grb Fudbalskog kluba Milutinac Zemun"
      decoding="async"
      loading={size === "large" ? "eager" : "lazy"}
    />
  </picture>
  {withText && (
    <span class="club-logo__text">
      <strong>FK Milutinac</strong>
      <span>Zemun / 1947</span>
    </span>
  )}
</span>

<style>
  .club-logo {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
  }

  .club-logo picture {
    width: var(--logo-size);
    height: var(--logo-size);
    flex: none;
  }

  .club-logo img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .club-logo--small {
    --logo-size: 44px;
  }

  .club-logo--regular {
    --logo-size: 58px;
  }

  .club-logo--large {
    --logo-size: 176px;
  }

  .club-logo__text {
    display: grid;
    gap: 1px;
    color: var(--text-on-dark);
    line-height: 1.1;
  }

  .club-logo__text strong {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 700;
  }

  .club-logo__text span {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
  }

  @media (max-width: 767px) {
    .club-logo--regular {
      --logo-size: 48px;
    }

    .club-logo--large {
      --logo-size: 126px;
    }

    .club-logo__text strong {
      font-size: 1rem;
    }
  }
</style>
