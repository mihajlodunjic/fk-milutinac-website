---
type Props = {
  href: string;
  label?: string;
  variant?: "primary" | "light" | "ghost" | "text";
  ariaLabel?: string;
  external?: boolean;
  disabled?: boolean;
};

const { href, label, variant = "text", ariaLabel, external = false, disabled = false } = Astro.props;
---

<a
  class={variant === "text" ? "text-link" : `button button--${variant}`}
  href={disabled ? undefined : href}
  aria-label={ariaLabel}
  aria-disabled={disabled ? "true" : undefined}
  tabindex={disabled ? "-1" : undefined}
  target={external && !disabled ? "_blank" : undefined}
  rel={external && !disabled ? "noopener noreferrer" : undefined}
>
  <slot>{label}</slot>
  <svg class="arrow-icon" viewBox="0 0 20 20" aria-hidden="true">
    <path d="M4 10h10.5M10.5 5 15 10l-4.5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" />
  </svg>
</a>
