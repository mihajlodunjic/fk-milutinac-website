---
import ActionLink from "@/components/global/ActionLink.astro";
import ClubLogo from "@/components/global/ClubLogo.astro";
import LocationBlock from "@/components/global/LocationBlock.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { business, contacts, telHref } from "@/data/business";
import { facilities } from "@/data/facilities";
import { seo } from "@/data/seo";
import { makeSchema } from "@/utils/schema";

const quickRoutes = [
  {
    title: "Upis u školu",
    text: "Pošaljite osnovne podatke i pitanje u vezi sa priključivanjem deteta odgovarajućoj grupi.",
    cta: "Pošalji upit",
    href: "/kontakt/#upis"
  },
  {
    title: "Grupe i termini",
    text: "Proverite aktuelnu grupu i raspored prema uzrastu deteta.",
    cta: "Pozovi školu",
    href: telHref(contacts.school.phone),
    ariaLabel: contacts.school.ariaLabel
  },
  {
    title: "Gde se trenira",
    text: "Treninzi se održavaju u sportskom kompleksu FK Milutinac na adresi Nade Dimić 5–7.",
    cta: "Otvori mapu",
    href: business.mapUrl,
    external: true
  },
  {
    title: "Balon i tereni",
    text: "Za rekreativne termine i korišćenje terena obratite se kontaktu za sportski kompleks.",
    cta: "Kontakt za termin",
    href: telHref(contacts.balloon.phone),
    ariaLabel: contacts.balloon.ariaLabel
  }
];

const programBlocks = [
  {
    title: "Učenje kroz igru",
    text: "Fudbalske veštine uvode se kroz zadatke, poligone i situacije koje detetu drže pažnju i podstiču ga da aktivno učestvuje."
  },
  {
    title: "Individualni napredak",
    text: "Svako dete se razvija svojim tempom. Trenerski rad treba da prepozna razlike i pomogne detetu da postepeno usvaja nove veštine."
  },
  {
    title: "Kretanje i motorika",
    text: "Trening ne čine samo potezi sa loptom. Važan deo rada su koordinacija, ravnoteža, snalaženje u prostoru i sigurnije kretanje."
  },
  {
    title: "Tim i sportske navike",
    text: "Trening je i mesto za saradnju, druženje, poštovanje pravila i stvaranje navike redovne fizičke aktivnosti."
  }
];
---

<BaseLayout seo={seo.home} schema={makeSchema({ path: "/" })}>
  <section class="home-hero section--dark" aria-labelledby="home-title">
    <div class="home-hero__inner container-wide">
      <p class="home-hero__side meta">ZEMUN / 1947</p>
      <div class="home-hero__copy reveal">
        <p class="eyebrow">FK MILUTINAC / ZEMUN / OD 1947.</p>
        <h1 id="home-title" class="hero-title">Prvi fudbalski koraci na Gardošu</h1>
        <p class="lead">
          Škola fudbala FK Milutinac okuplja decu kroz igru, učenje i rad usmeren na individualni napredak. Treninzi se
          održavaju u sportskom kompleksu u Zemunu, u balonu i na otvorenim terenima.
        </p>
        <div class="button-row">
          <ActionLink href="/kontakt/#upis" variant="primary">Pošalji upit za upis</ActionLink>
          <ActionLink href={telHref(contacts.school.phone)} variant="ghost" ariaLabel="Pozovi školu fudbala FK Milutinac">
            Pozovi školu fudbala
          </ActionLink>
        </div>
        <a class="home-hero__phone" href={telHref(contacts.school.phone)} aria-label={contacts.school.ariaLabel}>
          Kontakt škole: {contacts.school.phone}
        </a>
      </div>
      <div class="home-hero__visual" aria-label="Brendirana kompozicija FK Milutinac, grb i Gardoš">
        <span class="home-hero__year" aria-hidden="true">1947</span>
        <span class="home-hero__ring" aria-hidden="true"></span>
        <span class="home-hero__line home-hero__line--top" aria-hidden="true"></span>
        <span class="home-hero__line home-hero__line--bottom" aria-hidden="true"></span>
        <div class="home-hero__crest">
          <ClubLogo size="large" />
        </div>
        <p class="home-hero__visual-meta meta">ZEMUN / GARDOŠ</p>
      </div>
      <div class="home-hero__utility">
        <span>Nade Dimić 5–7, Zemun</span>
        <span>Balon i otvoreni tereni</span>
      </div>
    </div>
  </section>

  <section class="section quick-routes" aria-labelledby="quick-title">
    <div class="section__inner">
      <div class="section-heading">
        <p class="section-index">FKM / 01</p>
        <h2 id="quick-title">Od pitanja do pravog treninga</h2>
        <p>
          Uzrast, grupe i termini mogu da se menjaju tokom sezone. Izaberite informaciju koja vam je potrebna i javite se
          direktno odgovarajućem kontaktu.
        </p>
      </div>
      <div class="info-board">
        {quickRoutes.map((item, index) => (
          <article class="info-row">
            <span class="info-row__number">{String(index + 1).padStart(2, "0")}</span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
            <ActionLink href={item.href} ariaLabel={item.ariaLabel} external={item.external}>
              {item.cta}
            </ActionLink>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section school-approach" aria-labelledby="approach-title">
    <div class="section__inner grid-12">
      <div class="school-approach__heading">
        <p class="section-index">FKM / 02 / ŠKOLA FUDBALA</p>
        <h2 id="approach-title">Igra je početak. Napredak je proces.</h2>
      </div>
      <p class="school-approach__intro lead">
        Rad škole povezuje fudbalsku igru, razvoj kretanja, učenje i pripadnost timu. Cilj je da dete napreduje u skladu
        sa svojim uzrastom i da izgradi dugoročnu vezu sa sportom.
      </p>
      <div class="school-approach__program program-list">
        {programBlocks.map((item) => (
          <article class="program-row">
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
      <aside class="school-approach__panel" aria-label="Metadata škole fudbala">
        <span class="school-panel__number" aria-hidden="true">02</span>
        <p class="school-panel__label meta">ŠKOLA FUDBALA</p>
        <span class="school-panel__line" aria-hidden="true"></span>
        <p class="school-panel__sequence meta">IGRA / KRETANJE / NAPREDAK / TIM</p>
      </aside>
      <div class="school-approach__cta">
        <ActionLink href="/skola-fudbala/" variant="ghost">Pogledaj školu fudbala</ActionLink>
      </div>
    </div>
  </section>

  <section class="photo-break section--dark" aria-labelledby="photo-break-title">
    <div class="photo-break__copy section__inner">
      <span class="photo-break__line" aria-hidden="true"></span>
      <p class="eyebrow">ŠKOLA FUDBALA / GARDOŠ</p>
      <h2 id="photo-break-title">Važno je šta dete nauči — i da poželi ponovo da izađe na teren.</h2>
      <span class="photo-break__ring" aria-hidden="true"></span>
    </div>
  </section>

  <section class="section schedule-prompt" aria-labelledby="schedule-title">
    <div class="section__inner grid-12">
      <div class="schedule-prompt__copy">
        <p class="section-index">AKTUELNE INFORMACIJE</p>
        <h2 id="schedule-title">Prava grupa zavisi od uzrasta i rasporeda</h2>
        <p class="lead">
          Za informacije o aktuelnim grupama, terminima i mogućnosti priključivanja, javite se školi fudbala. Tako ćete
          dobiti podatke koji važe za trenutni deo sezone.
        </p>
      </div>
      <div class="schedule-prompt__board">
        <p class="meta">Kontakt škole: {contacts.school.phone}</p>
        <div class="button-row">
          <ActionLink href={telHref(contacts.school.phone)} variant="primary" ariaLabel={contacts.school.ariaLabel}>
            Pozovi školu fudbala
          </ActionLink>
          <ActionLink href="/kontakt/#upis" variant="ghost">Pošalji upit za upis</ActionLink>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--dark complex-index" aria-labelledby="complex-title">
    <div class="section__inner grid-12">
      <div class="complex-index__heading">
        <p class="section-index">FKM / 03 / KOMPLEKS</p>
        <h2 id="complex-title">Jedan kompleks, više razloga da dođete</h2>
      </div>
      <p class="complex-index__intro lead">
        Pored rada kluba i škole fudbala, na lokaciji Milutinca dostupni su balon sa veštačkom travom, otvoreni tereni,
        fudbalski rođendani i povezani ugostiteljski sadržaji.
      </p>
      <div class="complex-index__mark" aria-hidden="true">
        <span>03</span>
        <i></i>
      </div>
      <div class="complex-index__rows">
        {facilities.map((item) => (
          <article class="complex-row">
            <h3>{item.name}</h3>
            <p>{item.description}</p>
            <ActionLink href={item.key === "restaurant" ? item.href : telHref(item.contact.phone)} ariaLabel={item.contact.ariaLabel}>
              {item.key === "restaurant" ? "Pogledaj restoran i proslave" : item.contact.cta}
            </ActionLink>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section history-feature" aria-labelledby="history-title">
    <span class="soft-1947" aria-hidden="true">1947</span>
    <div class="section__inner grid-12">
      <div class="history-feature__copy">
        <p class="section-index">1947 / ZEMUN</p>
        <h2 id="history-title">Milutinac: ime koje nosi istoriju</h2>
        <p>Fudbalski klub Milutinac osnovan je 1947. godine u Zemunu.</p>
        <p>
          Klub nosi ime po Milutinu Ivkoviću „Milutincu“, jugoslovenskom reprezentativcu i kapitenu reprezentacije
          Jugoslavije na Svetskom prvenstvu 1930. godine.
        </p>
        <p>
          Danas se na istoj adresi susreću klupsko takmičenje, rad sa mlađim selekcijama, škola fudbala i svakodnevni
          život sportskog kompleksa.
        </p>
        <ActionLink href="/klub/" variant="ghost">Pročitaj o klubu</ActionLink>
      </div>
    </div>
  </section>

  <LocationBlock />

  <section class="section cta-band final-home-cta" aria-labelledby="final-home-title">
    <div class="section__inner">
      <p class="section-index">FKM / UPIS</p>
      <h2 id="final-home-title">Pitajte za grupu koja odgovara vašem detetu</h2>
      <p class="lead">Pošaljite upit ili pozovite školu fudbala da proverite aktuelne grupe i termine.</p>
      <div class="button-row">
        <ActionLink href="/kontakt/#upis" variant="primary">Pošalji upit za upis</ActionLink>
        <ActionLink href={telHref(contacts.school.phone)} variant="ghost" ariaLabel={contacts.school.ariaLabel}>
          Pozovi {contacts.school.phone}
        </ActionLink>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .home-hero {
    min-height: calc(92svh - var(--header-height));
    padding: 44px 0 34px;
    overflow: hidden;
    background:
      linear-gradient(90deg, rgba(250, 248, 243, 0.04) 1px, transparent 1px),
      linear-gradient(rgba(250, 248, 243, 0.04) 1px, transparent 1px),
      var(--ink-950);
    background-size: 72px 72px;
  }

  .home-hero__inner {
    position: relative;
    display: grid;
    grid-template-columns: 58px repeat(12, minmax(0, 1fr));
    gap: var(--gutter);
    min-height: calc(92svh - var(--header-height) - 78px);
    align-items: center;
    padding-inline: var(--page-pad);
  }

  .home-hero__side {
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    color: var(--text-muted-dark);
  }

  .home-hero__copy {
    grid-column: 2 / 9;
    display: grid;
    gap: 22px;
    align-content: center;
  }

  .home-hero__copy .lead {
    max-width: 650px;
    color: var(--text-muted-dark);
  }

  .home-hero__phone {
    width: fit-content;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    color: var(--text-muted-dark);
    font-family: var(--font-mono);
    font-size: 0.86rem;
  }

  .home-hero__visual {
    position: relative;
    grid-column: 9 / -1;
    align-self: stretch;
    min-height: 540px;
    isolation: isolate;
  }

  .home-hero__ring {
    position: absolute;
    z-index: 1;
    right: 0;
    top: 82px;
    width: min(430px, 88%);
    aspect-ratio: 1;
    border: 12px solid transparent;
    border-radius: 999px;
    background:
      linear-gradient(var(--ink-950), var(--ink-950)) padding-box,
      var(--gradient-brand) border-box;
    clip-path: polygon(8% 0, 100% 0, 100% 68%, 72% 90%, 28% 98%, 0 72%, 0 24%);
    animation: ring-draw 760ms var(--ease-board) both;
  }

  .home-hero__year {
    position: absolute;
    z-index: 0;
    top: 58px;
    right: -12px;
    color: rgba(250, 248, 243, 0.045);
    font-family: var(--font-mono);
    font-size: clamp(7.5rem, 14vw, 15rem);
    line-height: 1;
  }

  .home-hero__line {
    position: absolute;
    z-index: 0;
    right: 24px;
    left: 20%;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(250, 248, 243, 0.2), transparent);
  }

  .home-hero__line--top {
    top: 25%;
  }

  .home-hero__line--bottom {
    bottom: 18%;
  }

  .home-hero__crest {
    position: absolute;
    z-index: 3;
    top: 142px;
    right: 118px;
  }

  .home-hero__crest :global(.club-logo--large) {
    --logo-size: clamp(230px, 24vw, 360px);
  }

  .home-hero__visual-meta {
    position: absolute;
    z-index: 2;
    right: 26px;
    bottom: 72px;
    padding-top: 12px;
    color: var(--text-muted-dark);
    border-top: 2px solid transparent;
    border-image: var(--gradient-brand) 1;
  }

  .home-hero__utility {
    grid-column: 2 / -1;
    align-self: end;
    display: flex;
    justify-content: space-between;
    gap: 18px;
    padding-top: 22px;
    border-top: 1px solid var(--line-dark);
    color: var(--text-muted-dark);
    font-family: var(--font-mono);
    font-size: 0.82rem;
    text-transform: uppercase;
  }

  .school-approach__heading {
    grid-column: 1 / 6;
  }

  .school-approach__intro {
    grid-column: 7 / -1;
    color: var(--text-muted-light);
  }

  .school-approach__program {
    grid-column: 1 / 8;
    margin-top: 44px;
  }

  .school-approach__panel {
    grid-column: 8 / -1;
    margin-top: 44px;
    min-height: 520px;
    display: grid;
    align-content: end;
    gap: 22px;
    padding: 18px 0 8px 34px;
    border-left: 1px solid var(--line-light);
  }

  .school-panel__number {
    color: rgba(7, 17, 31, 0.08);
    font-family: var(--font-mono);
    font-size: clamp(8rem, 15vw, 14rem);
    line-height: 0.78;
  }

  .school-panel__label {
    color: var(--milutinac-red);
  }

  .school-panel__line {
    width: 4px;
    height: 156px;
    background: var(--gradient-brand);
  }

  .school-panel__sequence {
    max-width: 18ch;
    color: var(--text-muted-light);
  }

  .school-approach__cta {
    grid-column: 1 / 8;
    margin-top: 20px;
  }

  .photo-break {
    position: relative;
    min-height: 400px;
    display: grid;
    align-items: center;
    overflow: hidden;
    background:
      linear-gradient(90deg, rgba(250, 248, 243, 0.035) 1px, transparent 1px),
      linear-gradient(rgba(250, 248, 243, 0.035) 1px, transparent 1px),
      var(--ink-950);
    background-size: 72px 72px;
  }

  .photo-break__copy {
    position: relative;
    display: grid;
    gap: 18px;
    padding-block: 68px;
    padding-inline: var(--page-pad);
    isolation: isolate;
  }

  .photo-break__line {
    width: min(420px, 70vw);
    height: 3px;
    background: var(--gradient-brand);
  }

  .photo-break h2 {
    max-width: 920px;
    font-size: clamp(2.5rem, 5vw, 5rem);
    line-height: 1.02;
  }

  .photo-break__ring {
    position: absolute;
    z-index: -1;
    right: 2%;
    bottom: -48px;
    width: min(290px, 42vw);
    aspect-ratio: 1;
    border: 10px solid transparent;
    border-radius: 999px;
    background:
      linear-gradient(var(--ink-950), var(--ink-950)) padding-box,
      var(--gradient-brand) border-box;
    clip-path: polygon(0 0, 100% 0, 100% 66%, 70% 88%, 20% 100%, 0 68%);
    opacity: 0.7;
  }

  .schedule-prompt {
    background: var(--paper-50);
  }

  .schedule-prompt__copy {
    grid-column: 1 / 8;
    display: grid;
    gap: 20px;
  }

  .schedule-prompt__board {
    grid-column: 9 / -1;
    align-self: center;
    display: grid;
    gap: 24px;
    padding: 28px;
    border: 2px solid var(--ink-950);
    background: var(--paper-100);
    box-shadow: 4px 4px 0 var(--ink-950);
  }

  .complex-index__heading {
    grid-column: 1 / 8;
    display: grid;
    gap: 22px;
  }

  .complex-index .section__inner {
    position: relative;
  }

  .complex-index__intro {
    grid-column: 8 / -1;
    align-self: end;
    color: var(--text-muted-dark);
  }

  .complex-index__mark {
    position: absolute;
    top: -36px;
    right: 0;
    display: grid;
    justify-items: end;
    gap: 10px;
    pointer-events: none;
  }

  .complex-index__mark span {
    color: rgba(250, 248, 243, 0.06);
    font-family: var(--font-mono);
    font-size: clamp(6rem, 10vw, 10rem);
    line-height: 1;
  }

  .complex-index__mark i {
    width: 132px;
    height: 132px;
    border: 8px solid transparent;
    border-radius: 999px;
    background:
      linear-gradient(var(--ink-950), var(--ink-950)) padding-box,
      var(--gradient-brand) border-box;
    clip-path: polygon(0 0, 100% 0, 100% 62%, 54% 88%, 0 72%);
    opacity: 0.66;
  }

  .complex-index__rows {
    grid-column: 1 / -1;
    display: grid;
    gap: 0;
    margin-top: 56px;
    border-top: 1px solid var(--line-dark);
    border-bottom: 1px solid var(--line-dark);
  }

  .complex-row {
    display: grid;
    grid-template-columns: minmax(190px, 0.9fr) minmax(0, 1.7fr) minmax(160px, auto);
    gap: 22px;
    align-items: center;
    padding: 24px 0;
    border-bottom: 1px solid var(--line-dark);
  }

  .complex-row:last-child {
    border-bottom: 0;
  }

  .complex-row p {
    color: var(--text-muted-dark);
  }

  .history-feature {
    position: relative;
    overflow: hidden;
    background: var(--paper-50);
  }

  .history-feature__copy {
    position: relative;
    z-index: 1;
    grid-column: 3 / 10;
    display: grid;
    gap: 20px;
  }

  .history-feature__copy :global(.button) {
    width: fit-content;
    justify-self: start;
  }

  .final-home-cta .section__inner {
    display: grid;
    gap: 22px;
  }

  .final-home-cta h2 {
    max-width: 760px;
  }

  @keyframes ring-draw {
    from {
      opacity: 0;
      transform: rotate(-10deg) scale(0.92);
    }

    to {
      opacity: 1;
      transform: rotate(0) scale(1);
    }
  }

  @media (max-width: 1100px) {
    .home-hero__inner {
      grid-template-columns: repeat(8, minmax(0, 1fr));
    }

    .home-hero__side {
      display: none;
    }

    .home-hero__copy {
      grid-column: 1 / 6;
    }

    .home-hero__visual {
      grid-column: 6 / -1;
      min-height: 500px;
    }

    .home-hero__crest {
      top: 150px;
      right: 72px;
    }

    .home-hero__utility {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 900px) {
    .home-hero {
      min-height: auto;
    }

    .home-hero__inner {
      min-height: auto;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      align-items: start;
    }

    .home-hero__copy,
    .home-hero__visual,
    .home-hero__utility {
      grid-column: 1 / -1;
    }

    .home-hero__visual {
      min-height: 350px;
      margin-top: 18px;
    }

    .home-hero__year {
      top: 8px;
      right: 0;
      font-size: clamp(5.5rem, 26vw, 10rem);
    }

    .home-hero__line {
      right: 0;
      left: 0;
    }

    .home-hero__ring {
      top: 28px;
      right: 4px;
      width: min(310px, 78vw);
      border-width: 9px;
    }

    .home-hero__crest {
      top: 76px;
      right: auto;
      left: 50%;
      transform: translateX(-50%);
    }

    .home-hero__crest :global(.club-logo--large) {
      --logo-size: min(230px, 58vw);
    }

    .home-hero__visual-meta {
      right: 0;
      bottom: 12px;
    }

    .home-hero__utility {
      flex-direction: column;
      gap: 8px;
    }
  }

  @media (max-width: 1023px) {
    .school-approach__heading,
    .school-approach__intro,
    .school-approach__program,
    .school-approach__panel,
    .school-approach__cta,
    .schedule-prompt__copy,
    .schedule-prompt__board,
    .complex-index__heading,
    .complex-index__intro,
    .complex-index__mark,
    .complex-index__rows,
    .history-feature__copy {
      grid-column: 1 / -1;
    }

    .school-approach__panel {
      min-height: auto;
      grid-template-columns: auto 1fr;
      align-items: center;
      padding: 18px 0;
      border-top: 1px solid var(--line-light);
      border-bottom: 1px solid var(--line-light);
      border-left: 0;
    }

    .school-panel__number {
      font-size: 5rem;
      line-height: 1;
    }

    .school-panel__line {
      width: 100%;
